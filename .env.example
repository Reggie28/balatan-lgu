# Balatan LGU — environment variable template.
#
# This app reads configuration ONLY from real process environment variables
# (src/config/config.js) — there is no dotenv dependency, so this file is
# NOT loaded automatically. It exists purely as a reference for what to set
# on your host/platform (export them in your shell, your process manager, or
# your PaaS's environment-variable settings).
#
# Copy the values you need into your actual deployment environment. NEVER
# commit a real .env file — .gitignore already excludes .env / .env.* .
# Every value below is a placeholder; none of it is a real secret.

# --- Environment ------------------------------------------------------------
# Set to "production" on any real deployment. This also hard-disables
# BALATAN_TURNSTILE_DEV_BYPASS regardless of its own value (see below).
NODE_ENV=production

# --- Server -------------------------------------------------------------------
# Bind address. Use 0.0.0.0 when the app sits behind a reverse proxy / PaaS
# so the proxy (on the same host or container network) can reach it. Keep
# 127.0.0.1 for a single-box setup with no proxy.
BALATAN_HOST=0.0.0.0
BALATAN_PORT=5000

# --- Admin credentials (REQUIRED to change before production) -----------------
# The code ships with documented demo defaults (admin / balatan2026) — you
# MUST override both before any real deployment.
BALATAN_ADMIN_USER=change-me
BALATAN_ADMIN_PASS=change-me-to-a-strong-password
# Hidden dashboard path (not /admin). Change from the default for a small
# extra layer of obscurity; it is not itself a security boundary.
BALATAN_ADMIN_PATH=change-me-secret-path

# --- MySQL --------------------------------------------------------------------
# Point at your real production database. Defaults (127.0.0.1:3307, root, no
# password) only work with the bundled portable MySQL used for local/demo use.
BALATAN_DB_HOST=127.0.0.1
BALATAN_DB_PORT=3306
BALATAN_DB_USER=balatan_app
BALATAN_DB_PASS=change-me
BALATAN_DB_NAME=balatan_lgu

# --- Cloudflare Turnstile (CAPTCHA) --------------------------------------------
# Without these, report submission fails closed (rejected) by design — see
# BALATAN_TURNSTILE_DEV_BYPASS below for local testing only.
BALATAN_TURNSTILE_SITE_KEY=
BALATAN_TURNSTILE_SECRET_KEY=
# Development/demo only. Bypasses real CAPTCHA verification. Automatically
# ignored whenever NODE_ENV=production, but still leave this unset/0 in any
# production environment variable file as defense in depth.
BALATAN_TURNSTILE_DEV_BYPASS=0

# --- SMTP (OTP email delivery) -------------------------------------------------
# Without SMTP, verification/reset codes print to the server console instead
# of being emailed — acceptable for local demos only, not production.
BALATAN_SMTP_HOST=
BALATAN_SMTP_PORT=587
BALATAN_SMTP_USER=
BALATAN_SMTP_PASS=
BALATAN_SMTP_FROM=

# --- Resident geofence ----------------------------------------------------------
# Restricts resident sign-in/reporting to within BALATAN_GEOFENCE_KM of the
# municipality center. BALATAN_GEOFENCE=0 disables the check entirely.
BALATAN_GEOFENCE=1
BALATAN_GEOFENCE_KM=15

# --- Temporary presentation/demo bypass ----------------------------------------
# Bypasses the geofence check entirely. Leave unset/0 in production — this is
# strictly a same-day-demo convenience, not a production setting.
BALATAN_DEMO_MODE=0

# --- Inter-office coordination email (optional) --------------------------------
# JSON map of office name -> contact email, used only for the optional
# coordination-tagging notice. Leave unset if not needed.
# Example: BALATAN_OFFICE_CONTACTS={"Water District":"realaddress@example.gov.ph"}
BALATAN_OFFICE_CONTACTS=

# --- Offense / fake-report policy (optional — sensible defaults exist) --------
BALATAN_STRIKE_LIMIT=3
BALATAN_OFFENSE_SUSPENSION_DAYS=30
